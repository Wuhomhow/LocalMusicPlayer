<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Vinyl Body -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#1A1A1A" />
            <stroke android:width="4dp" android:color="#2D2D2D" />
            <size android:width="260dp" android:height="260dp" />
        </shape>
    </item>
    <!-- Vinyl Groove 1 -->
    <item android:top="20dp" android:bottom="20dp" android:left="20dp" android:right="20dp">
        <shape android:shape="oval">
            <stroke android:width="1.5dp" android:color="#242424" />
        </shape>
    </item>
    <!-- Vinyl Groove 2 -->
    <item android:top="40dp" android:bottom="40dp" android:left="40dp" android:right="40dp">
        <shape android:shape="oval">
            <stroke android:width="1.5dp" android:color="#2C2C2C" />
        </shape>
    </item>
    <!-- Vinyl Groove 3 -->
    <item android:top="60dp" android:bottom="60dp" android:left="60dp" android:right="60dp">
        <shape android:shape="oval">
            <stroke android:width="1.5dp" android:color="#262626" />
        </shape>
    </item>
    <!-- Center Label -->
    <item android:top="80dp" android:bottom="80dp" android:left="80dp" android:right="80dp">
        <shape android:shape="oval">
            <gradient
                android:angle="45"
                android:startColor="#7C4DFF"
                android:endColor="#1DB954" />
        </shape>
    </item>
    <!-- Center Spindle Hole -->
    <item android:top="120dp" android:bottom="120dp" android:left="120dp" android:right="120dp">
        <shape android:shape="oval">
            <solid android:color="#121212" />
        </shape>
    </item>
</layer-list>
